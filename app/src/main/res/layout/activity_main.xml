<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto-dial a USSD code when a till payment SMS arrives"
            android:textColor="#666666"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnGrantPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant SMS + Call permissions"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Till / account number (optional filter)"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etTillNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 123456"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMS sender filter (comma separated)"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etSenderFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MPESA"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USSD code to dial on payment"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etUssdTemplate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. *544*1*{amount}#"
            android:inputType="text"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Use {amount} where the paid amount should be inserted"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dial silently (no dialer popup)"/>
            <Switch
                android:id="@+id/switchSilent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Watcher enabled"
                android:textStyle="bold"/>
            <Switch
                android:id="@+id/switchEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save settings"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnTestDial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test dial configured USSD code"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activity log"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:background="#F2F2F2"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="No activity yet."/>

    </LinearLayout>
</ScrollView>
